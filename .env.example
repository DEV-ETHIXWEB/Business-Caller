# Copy this file to .env.local for local development and fill in real
# values. Never commit .env.local — it is already in .gitignore.
#
# In Vercel, set these same names/values under
# Project Settings -> Environment Variables instead of committing a file.

# --- From Twilio Console > Account > Account Info ---
TWILIO_ACCOUNT_SID=

# --- From Twilio Console > Account > API keys & tokens (a Standard API Key you create) ---
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# --- From Twilio Console > Account > Account Info (click "View" next to Auth Token) ---
# Used ONLY on the server to verify that requests to /api/voice really come
# from Twilio. Never sent to the browser.
TWILIO_AUTH_TOKEN=

# --- From the TwiML App you create under Twilio Console > Voice > Manage > TwiML Apps ---
TWILIO_TWIML_APP_SID=

# --- A Twilio Sync Service, used to store each person's Phone Book and
# Face ID/Touch ID credentials so they show up on every device, not just the
# one that added them. Create one under Twilio Console > Explore Products >
# Sync > Services > Create new Sync Service (any friendly name), then copy
# its SID here. ---
TWILIO_SYNC_SERVICE_SID=

# One shared dialer, one login per person. Each entry needs a Voice-enabled
# Twilio number in E.164 format - that number becomes both that person's
# caller ID on calls and sender ID on SMS. All logins share the same TwiML
# App/Voice Request URL; no per-person Twilio Console setup is needed beyond
# provisioning the number itself. Make every password long and random - it
# is the main thing stopping a stranger who finds the URL from placing calls
# or reading messages on that person's number.
APP_USERS=[{"username":"amar","password":"","phoneNumber":"+12064523433","label":"Amar"}]

# The exact public URL this app is deployed at, with no trailing slash.
# Locally with `vercel dev` or a tunnel this must match what you configured
# as the TwiML App's Voice Request URL (see README for local testing notes).
# Example: https://business-caller.vercel.app
PUBLIC_BASE_URL=

# --- Vercel Blob storage, used to store uploaded profile photos. In the
# Vercel dashboard: Project > Storage > Create Database > Blob, then attach
# it to this project - Vercel adds this variable to your project's
# environment automatically. Not needed for calling/texting; only profile
# photo upload/removal (app/api/avatar/route.ts) uses it. ---
BLOB_READ_WRITE_TOKEN=
