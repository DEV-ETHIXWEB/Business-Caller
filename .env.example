# Copy this file to .env.local for local development and fill in real
# values. Never commit .env.local — it is already in .gitignore.
#
# In Vercel, set these same names/values under
# Project Settings -> Environment Variables instead of committing a file.

# --- From Twilio Console > Account > Account Info ---
TWILIO_ACCOUNT_SID=

# --- From Twilio Console > Account > API keys & tokens (a Standard API Key you create) ---
TWILIO_API_KEY_SID=
TWILIO_API_KEY_SECRET=

# --- From Twilio Console > Account > Account Info (click "View" next to Auth Token) ---
# Used ONLY on the server to verify that requests to /api/voice really come
# from Twilio. Never sent to the browser.
TWILIO_AUTH_TOKEN=

# --- From the TwiML App you create under Twilio Console > Voice > Manage > TwiML Apps ---
TWILIO_TWIML_APP_SID=

# Your Twilio Voice-enabled number, in E.164 format. This is what clients
# see as the caller ID.
TWILIO_PHONE_NUMBER=+12064523433

# A shared passphrase Amar enters once per browser session to unlock the
# dialer. Make this long and random - it is the main thing stopping a
# stranger who finds the URL from placing calls on your account.
APP_ACCESS_CODE=

# The exact public URL this app is deployed at, with no trailing slash.
# Locally with `vercel dev` or a tunnel this must match what you configured
# as the TwiML App's Voice Request URL (see README for local testing notes).
# Example: https://business-caller.vercel.app
PUBLIC_BASE_URL=
